/* 基础全局QSS，避免Qt未知属性警告 */
QWidget {
  font-family: "Microsoft YaHei";
  font-size: 12px;
  color: #333;
}
QLabel#PageTitle {
  color: #228b22;
  font-size: 28px;
  font-weight: bold;
}
QPushButton {
  padding: 6px 12px;
  border: 2px solid #2196F3;
  border-radius: 6px;
  background-color: #e3f2fd;
  color: #1565C0;
}
QPushButton:hover {
  background-color: #bbdefb;
  border-color: #1976D2;
}
QPushButton:pressed {
  background-color: #90caf9;
}
QTableWidget {
  background-color: white;
  gridline-color: #7bb1e0;
}
QHeaderView::section {
  background-color: #f0f8ff;
  font-weight: bold;
}