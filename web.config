<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 默认首页，移动端扫码展示页面 -->
    <defaultDocument enabled="true">
      <files>
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- 显式关闭 HTTP 重定向，防止流量被跳到外部域名 -->
    <httpRedirect enabled="false" />

    <!-- URL 重写（兼容历史域名、参数一致化） -->
    <rewrite>
      <rules>
        <!-- 0) API resolve endpoint for scan compatibility -->
        <rule name="API Resolve" stopProcessing="true">
          <match url="^api/resolve$" />
          <action type="Rewrite" url="/api/resolve.php" appendQueryString="true" />
        </rule>

        <!-- 1) scan.example.com 是主要扫码域名，不需要重定向 -->
        <!-- 保持 scan.example.com 作为主要扫码服务域名 -->

        <!-- 2) 如果访问 index.html?id=A-Q...，则 302 统一跳转为 index.html?code=A-Q...（参数统一：id -> code） -->
        <rule name="Unify id to code" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{QUERY_STRING}" pattern="(^|&)id=((A|B)-Q\d{9})(&|$)" />
          </conditions>
          <action type="Redirect" url="/index.html?code={C:2}" redirectType="Found" />
        </rule>

        <!-- 3) 确保 companies/* 下的 .json 作为静态资源直接返回（交由 staticContent/MIME 处理） -->
        <rule name="Allow JSON under companies" stopProcessing="true">
          <match url="^companies/(demo_json_a|demo_json_b)/.*\.json$" />
          <action type="None" />
        </rule>
      </rules>
    </rewrite>

    <!-- 已移除 handlers（PHP 处理程序），以避免父级锁定导致的 500.19 错误；当前站点采用“静态直读 JSON”方案，无需在此处声明 PHP。 -->

    <!-- JSON MIME 与 CORS 设置 -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
    </staticContent>

    <!-- 显式允许 .json 扩展，避免请求筛选在上级被拒绝 -->
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <fileExtensions>
          <add fileExtension=".json" allowed="true" />
        </fileExtensions>
        <verbs>
          <add verb="GET" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
      </customHeaders>
    </httpProtocol>

    <!-- 压缩（可选）：对 JSON 启用动态压缩可降低带宽占用 -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    
    <!-- 详细错误信息 -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

  </system.webServer>
</configuration>
