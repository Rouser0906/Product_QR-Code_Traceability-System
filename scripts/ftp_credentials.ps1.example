# FTP凭据配置文件示例
# 请复制此文件为 ftp_credentials.ps1 并填入实际凭据
# 注意：ftp_credentials.ps1 已添加到 .gitignore，不会被提交到版本控制

$FtpHost = 'your-ftp-server.com'
$FtpPort = 21
$FtpUser = 'your_ftp_username'
$FtpPassword = 'your_ftp_password'

# 导出变量供其他脚本使用
$Global:FtpConfig = @{
    Host = $FtpHost
    Port = $FtpPort
    User = $FtpUser
    Password = $FtpPassword
}
